# Environment: "production" on Cloud Run, "local" only on your developer laptop
ENV=production

# Comma-separated allowed frontend origins (no trailing slashes)
CORS_ORIGINS=https://starfieldcosmicchess.com,https://www.starfieldcosmicchess.com,https://your-project-id.web.app,https://your-project-id.firebaseapp.com

# Pi Platform API base URL
PI_API_BASE_URL=https://api.minepi.com

# On Cloud Run, leave GOOGLE_APPLICATION_CREDENTIALS unset to use the attached service account IAM identity.
# Locally, point to a downloaded Firebase Admin JSON key (NEVER commit it to Git).
# GOOGLE_APPLICATION_CREDENTIALS=./service-account-local.json
