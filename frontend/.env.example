# FastAPI Cloud Run Backend URL (no trailing slash)
VITE_API_BASE_URL=https://starfield-api-REPLACE_ME.run.app

# Set to "true" ONLY when testing in Pi Sandbox; set to "false" for Production/Mainnet
VITE_PI_SANDBOX=true

# Firebase Web App Config (from Firebase Console -> Project Settings -> Your Apps)
VITE_FIREBASE_API_KEY=your_firebase_api_key
VITE_FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project-id.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
VITE_FIREBASE_APP_ID=your_app_id
